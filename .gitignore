# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# IDE
.idea/
.vscode/

# CodeGraph index
.codegraph/

# Example runtime artifacts (generated by `go run .`)
examples/*/snapshot/
examples/hotreload-file/config.json

# Compiled example binaries (each example dir is a module; `go build .` drops a
# binary named after the dir)
examples/consul/consul
examples/etcd/etcd
examples/git/git
examples/hotreload-file/hotreload-file
examples/springcloud/springcloud
examples/vault/vault
examples/multisource/multisource
